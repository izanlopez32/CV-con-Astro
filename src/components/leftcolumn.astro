---
import IconoCorreo from "../assets/correo.svg";
import IconoUbicacion from "../assets/ubicacion.svg";
import IconoTelefono from "../assets/telefono.svg";
const aptitudes = [
    {
        contenido:
            "Capacidad de manejar<br>fácilmente una situación<br>bajo mucha presión",
    },
    {
        contenido: "Amigable con el entorno<br>laboral",
    },
    {
        contenido:
            "Persona con ganas de<br>aprender incluyendo<br>una gran facilidad para<br>ello y con una gran<br>pasión por la<br>programación ",
    },
];

const idiomas = [
    {
        nombre: "Castellano:",
        nivel: "Nativo.",
    },
    {
        nombre: "Ingles:",
        nivel: "Nivel Medio.",
    },
];
const numero = "+34-600-66-11-50";
const correo = "izanortega22@gmail.com";
const ubicacion = "Valdemoro, Madrid";
const github = "https://izanlopez32.github.io/Pagina-<br>Izan-Lopez-Ortega";
---

<!--Al usar tailwind podemos usar [] para el uso de valores exactos -->
<div id="leftcolumn" class="flex-grow flex-shrink basis-[250px] px-20">
    <p class="text-xl font-bold">CONTACTO</p>
    <div class="flex items-center max-[600px]:text-sm gap-4 mb-2 mt-6 hover:scale-105 hover:border border-violet-900 rounded-4xl duration-200 hover:bg-violet-400 transition py-2">
        <img src={IconoTelefono.src} /><span>{numero}</span>
    </div>
    <div class="flex items-center max-[600px]:text-sm gap-4 my-2 hover:scale-105 hover:border border-violet-900 rounded-4xl duration-200 hover:bg-violet-400 transition py-2">
        <img src={IconoCorreo.src} /><span>{correo}</span>
    </div>
    <div class="flex items-center max-[600px]:text-sm gap-4 my-2 hover:scale-105 hover:border border-violet-900 rounded-4xl duration-200 hover:bg-violet-400 transition py-2 ">
        <img src={IconoUbicacion.src} /><span>{ubicacion}</span>
    </div>
    <div class="flex items-center max-[600px]:text-sm gap-4 my-2 hover:scale-105 hover:border border-violet-900 rounded-4xl duration-200 hover:bg-violet-400 transition py-2">
        <img src={IconoCorreo.src} /><span set:html={github} />
    </div>
    <p class="text-xl font-bold mt-6">DATOS PERSONALES</p>
    <div id="fnacimiento" class="flex flex-col justify-center mt-[12px] max-[600px]:text-sm ml-5">
        <p><b>Fecha de nacimiento</b></p>
        <span>29 de Agosto de 2005</span>
    </div>
    <p class="text-xl font-bold mt-10">IDIOMAS</p>
    <div id="idiomas" class="flex flex-col gap-8 mt-4 max-[600px]:text-sm">
        {
            idiomas.map((idioma) => (
                <div>
                    <p>
                        <strong>{idioma.nombre}</strong>
                    </p>
                    <span>{idioma.nivel}</span>
                </div>
            ))
        }
    </div>
    <p class="text-xl font-bold mt-10">APTITUDES</p>
    <div id="aptitudes" class="max-[600px]:text-sm">
        <div>
            <ul class="list-disc flex flex-col gap-6 mt-4 ml-5 max-[600px]:mb-10">
                {
                    aptitudes.map((aptitud) => (
                        <li set:html={aptitud.contenido} />
                    ))
                }
            </ul>
        </div>
    </div>
</div>
